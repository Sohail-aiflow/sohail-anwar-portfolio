# auto: local when both CMS fields are blank; published CMS reads when configured.
# local: explicit offline content. sanity: require a complete CMS configuration.
PORTFOLIO_CONTENT_SOURCE=auto
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=2026-10-13
# Use a PUBLIC dataset. No read/write token is consumed by the portfolio.
# Never put credentials in NEXT_PUBLIC_* or SANITY_STUDIO_* variables.

# Leave blank until the hosting origin is selected. No localhost canonicals.
SITE_URL=
# Enable only for the approved public launch; previews remain noindex.
SITE_INDEXABLE=false
